\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Dominant conduction mechanism and cycle-to-cycle assignment stability for each resistance-state segment and deposition condition. The post-SET LRS is consistently ohmic; the high-resistance segments are barrier-limited but not cleanly separable (the post-RESET HRS full-window label is near-ohmic in most conditions and Schottky-like in others, with a robust Schottky signature at higher voltage).}}{6}{}\protected@file@percent }
\newlabel{fig:mechanism-map}{{2}{6}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Out-of-sample fit quality. Box plots: distribution of $\qopname  \relax o{log}_{10}|I|$ RMSE when the model fitted to the medoid cycle is scored against every other measured cycle of the device (whiskers exclude outliers). Stars mark the in-sample (medoid) RMSE. The held-out median tracks the in-sample error closely on average; per-condition agreement varies (S1 RESET is a flagged outlier), so we report the distribution rather than claiming the two are statistically indistinguishable.}}{6}{}\protected@file@percent }
\newlabel{fig:heldout}{{3}{6}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces S1 fitted curve (red) against the measured cycle-to-cycle envelope (min--max and interquartile bands, with the measured median) along the sweep sequence; the secondary axis marks voltage. The fit stays within the measured spread except at the SET transition and the HRS approach.}}{6}{}\protected@file@percent }
\newlabel{fig:overlay}{{4}{6}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Unseen-device validation. Box plots: per-cycle $\qopname  \relax o{log}_{10}|I|$ RMSE when the medoid-fitted model is scored against cycles of held-out \emph  {devices} (never used for selection or fitting). Stars mark the same-device held-out median for comparison. The model generalizes to unseen devices with only a modest median increase over same-device cycle hold-out.}}{6}{}\protected@file@percent }
\newlabel{fig:population}{{5}{6}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {IV-E}}Identifiability: What DC Data Actually Constrain}{6}{}\protected@file@percent }
