\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Cycle-to-cycle parameter variability from 200 cluster-bootstrap refits per condition (color: $\qopname  \relax o{log}_{10}\mathrm  {CV}$). Branch voltage scales are comparatively repeatable; series resistance and velocity prefactors are the least stable. This bootstrap CV is our primary identifiability evidence.}}{7}{}\protected@file@percent }
\newlabel{fig:param-cv}{{6}{7}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {IV-F}}Ablation: What Each Ingredient Buys}{7}{}\protected@file@percent }
