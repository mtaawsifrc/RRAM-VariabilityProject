\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Conduction-regime classification of the four resistance-state segments of the S1 representative cycle. LRS segments are ohmic ($R^2\ge 0.98$); HRS segments are dominated by Schottky emission, with a Fowler--Nordheim window near the SET transition. No Poole--Frenkel window is admitted by the $\varepsilon _r^{\mathrm  {dyn}}$ test.}}{4}{}\protected@file@percent }
\newlabel{fig:regimes}{{1}{4}}
\@writefile{lot}{\contentsline {table}{\numberline {II}{\ignorespaces Validation fit quality per condition: unweighted RMSE of $\qopname  \relax o{log}_{10}|I|$ (decades) and Durbin--Watson statistics.}}{4}{}\protected@file@percent }
\newlabel{tab:fitquality}{{II}{4}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {IV-C}}Out-of-Sample Generalization Across Measured Cycles}{4}{}\protected@file@percent }
\newlabel{sec:res-heldout}{{\mbox  {IV-C}}{4}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Dominant conduction mechanism and cycle-to-cycle assignment stability for each resistance-state segment and deposition condition. The post-SET LRS is consistently ohmic, whereas the post-RESET HRS is Schottky-dominant for all twelve conditions.}}{5}{}\protected@file@percent }
\newlabel{fig:mechanism-map}{{2}{5}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Out-of-sample fit quality. Box plots: distribution of $\qopname  \relax o{log}_{10}|I|$ RMSE when the model fitted to the medoid cycle is scored against every other measured cycle of the device (whiskers exclude outliers). Stars mark the in-sample (medoid) RMSE. Held-out and in-sample errors are statistically indistinguishable, evidencing generalization rather than overfitting.}}{5}{}\protected@file@percent }
\newlabel{fig:heldout}{{3}{5}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces S1 fitted curve (red) against the measured cycle-to-cycle envelope (min--max and interquartile bands, with the measured median) along the sweep sequence; the secondary axis marks voltage. The fit stays within the measured spread except at the SET transition and the HRS approach.}}{5}{}\protected@file@percent }
\newlabel{fig:overlay}{{4}{5}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {IV-D}}Identifiability: What DC Data Actually Constrain}{5}{}\protected@file@percent }
